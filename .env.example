NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Must be the secret service_role key from Supabase Dashboard, not the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: use this if you want to keep a private server-only URL variable too.
SUPABASE_URL=https://your-project.supabase.co

# Public app URL for Telegram webhook setup; replace after deployment.
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app/

# Optional server-only credentials for booking notifications. Keep these secret.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id
